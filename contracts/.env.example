# ---------------------------------------------------------------------------
# Monad Testnet environment variables
# Copy this file to `.env` and fill in your values. Never commit a real .env.
# ---------------------------------------------------------------------------

# Official Monad testnet RPC (EVM-compatible). See foundry.toml for alternatives.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Deployer private key. FUND THIS ADDRESS via the Monad faucet BEFORE deploying.
# Get testnet MON at: https://testnet.monad.xyz/
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Optional: explorer API key for `forge verify-contract`.
MONAD_EXPLORER_API_KEY=
